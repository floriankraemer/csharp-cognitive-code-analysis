<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>CognitiveCodeAnalysis</AssemblyName>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Self-contained + RID: pass -r and /p:SelfContained=true on publish. Single-file only with RID; pack-as-tool has no RID. -->
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">false</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(RuntimeIdentifier)' != ''">true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>CognitiveCodeAnalysis</ToolCommandName>
    <!-- PackageId must differ from the CognitiveCodeAnalysis library project in the same solution. -->
    <PackageId>CognitiveCodeAnalysis.Tool</PackageId>
    <Version>1.0.0</Version>
    <Authors>Florian Krämer</Authors>
    <Description>Cognitive complexity analysis for C# — reports for readability and human working-memory load.</Description>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CognitiveCodeAnalysis\CognitiveCodeAnalysis.csproj" />
  </ItemGroup>

</Project>
