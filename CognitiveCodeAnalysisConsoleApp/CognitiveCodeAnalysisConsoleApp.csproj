<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Self-contained + RID: pass -r and /p:SelfContained=true on publish. Single-file only with RID; pack-as-tool has no RID. -->
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">false</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(RuntimeIdentifier)' != ''">true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>CognitiveCodeAnalysis</ToolCommandName>
    <!-- PackageId must differ from the CognitiveCodeAnalysis library project in the same solution. -->
    <PackageId>CognitiveCodeAnalysis.Tool</PackageId>
    <Version>1.0.0</Version>
    <Authors>Florian Krämer</Authors>
    <Description>Cognitive complexity analysis for C# — reports for readability and human working-memory load.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.54.0" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.53.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CognitiveCodeAnalysis\CognitiveCodeAnalysis.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\CognitiveCodeAnalysis\cognitive-metrics-settings.json" Link="cognitive-metrics-settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CognitiveCodeAnalysisConsoleApp.Tests" />
  </ItemGroup>

</Project>
