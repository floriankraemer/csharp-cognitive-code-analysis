            },
            "returnCount": {
                "threshold": 2,
                "scale": 5.0,
                "enabled": true
            },
            "variableCount": {
                "threshold": 4,
                "scale": 5.0,
                "enabled": false
            },
            "propertyCallCount": {
                "threshold": 4,
                "scale": 15.0,
                "enabled": false
            },
            "fieldAccessCount": {
