{
    "cognitive": {
        "excludeFilePatterns": [],
        "excludePatterns": [],
        "scoreThreshold": 0.5,
        "showOnlyMethodsExceedingThreshold": true,
        "showHalsteadComplexity": false,
        "showCyclomaticComplexity": false,
